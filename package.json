{
  "name": "riskguard",
  "version": "1.0.0",
  "description": "MetroPay Credit Risk & Underwriting Platform",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "migrate": "tsx src/migrate.ts",
    "seed": "tsx seed/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "worker:repayment": "tsx src/workers/repayment-executor.ts",
    "worker:dpd": "tsx src/workers/dpd-tracker.ts"
  },
  "dependencies": {
    "better-sqlite3": "^12.0.0",
    "dotenv": "^16.4.1",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "pino": "^8.18.0",
    "pino-http": "^9.0.0",
    "undici": "^6.6.2",
    "uuid": "^9.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/express": "^4.17.21",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^9.0.7",
    "supertest": "^6.3.4",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3",
    "vitest": "^1.2.2"
  }
}
